# Staging content pipeline + deploy — copy to scripts/.env (gitignored)
# ADMIN_* for push/login: taken from repo root .env when present (same password as admin UI)
STAGING_API_URL=https://staging-api.alicecommands.ru
ADMIN_USERNAME=miron
ADMIN_PASSWORD=change-me

# Cloudflare DNS (scripts/cloudflare-dns-direct.ps1, setup-cdn.ps1) — gitignored token
CF_API_TOKEN=
CF_ZONE_NAME=alicecommands.ru
CF_DNS_RECORDS=staging-api,cdn,api
STAGING_ORIGIN_IP=161.104.46.92
PROD_API_URL=https://api.alicecommands.ru
PROD_ORIGIN_IP=161.104.46.92

# Deploy to Selectel VPS (scripts/deploy-staging.ps1)
SSH_KEY_PATH=C:\Users\rybak\.ssh\id_ed25519_selectel
SSH_HOST=root@161.104.46.92
DEPLOY_REMOTE_APP=/opt/alice-api/app
DEPLOY_REMOTE_DEPLOY=/opt/alice-api/deploy

# Copy via VPS localhost (recommended until DNS + TLS for api.*)
COPY_PROD_VIA_SSH=1

# Publish visuals with cdn host in bundle (after setup-cdn.ps1 + DNS)
# USE_CDN_ICON_URLS=1
