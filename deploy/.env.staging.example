# Staging server env (secrets) — copy to /opt/alice-api/.env on VPS
APP_ENV=staging
APP_PORT=8080
PUBLIC_BASE_URL=https://staging-api.alicecommands.ru

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-use-strong-password

DATABASE_URL=jdbc:postgresql://localhost:5432/alice_commands_staging
DATABASE_USER=alice
DATABASE_PASSWORD=generate-random-db-password

BUNDLE_STORAGE_PATH=/opt/alice-api/storage/bundles
MANIFEST_STORAGE_PATH=/opt/alice-api/storage/manifest
BUNDLE_RETENTION_COUNT=5

SESSION_SECRET=generate-random-48-chars-minimum
ADMIN_LOGIN_RATE_LIMIT=5

# Category / group icons (see docs/BACKEND-CATEGORY-VISUALS.md)
ICON_STORAGE_PATH=/opt/alice-api/storage/icons
ICON_PUBLIC_BASE_URL=https://staging-api.alicecommands.ru
ICON_URL_ALLOWED_HOSTS=staging-api.alicecommands.ru,cdn.alicecommands.ru,api.alicecommands.ru,localhost,127.0.0.1

# Optional: seed catalog on VPS for admin «Import seed» button
# CONTENT_SEED_PATH=/opt/alice-api/seed/full-catalog.json
