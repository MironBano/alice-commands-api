# Production server env — copy to /opt/alice-api/.env.prod on VPS (never commit secrets)
APP_ENV=prod
APP_PORT=8081
PUBLIC_BASE_URL=https://api.alicecommands.ru

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-use-strong-password

DATABASE_URL=jdbc:postgresql://localhost:5432/alice_commands
DATABASE_USER=alice
DATABASE_PASSWORD=generate-random-db-password

BUNDLE_STORAGE_PATH=/opt/alice-api/storage-prod/bundles
MANIFEST_STORAGE_PATH=/opt/alice-api/storage-prod/manifest
BUNDLE_RETENTION_COUNT=5

SESSION_SECRET=generate-random-48-chars-minimum
ADMIN_LOGIN_RATE_LIMIT=5

ICON_STORAGE_PATH=/opt/alice-api/storage/icons
ICON_PUBLIC_BASE_URL=https://cdn.alicecommands.ru
ICON_URL_ALLOWED_HOSTS=api.alicecommands.ru,cdn.alicecommands.ru,staging-api.alicecommands.ru,localhost,127.0.0.1

DEVICE_IMAGE_STORAGE_PATH=/opt/alice-api/storage/devices
CONTENT_SEED_PATH=/opt/alice-api/seed/catalog-audit-fixed.json

ANALYTICS_RATE_LIMIT_PER_IP=120
ANALYTICS_EVENTS_PER_IP_PER_DAY=10000
ANALYTICS_MAX_BODY_BYTES=262144
ANALYTICS_RAW_RETENTION_DAYS=90

# RuStore Push campaigns
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_SERVICE_TOKEN=
PUSH_CAMPAIGN_ENABLED=true
# Keep false until stage go/no-go; then flip with new product-card snapshot
REQUIRE_PICK_AFFILIATE_QUERY=false
MARKET_AFFILIATE_REFRESH_ENABLED=false
