{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alice-commands-api/schema/content-bundle.schema.json",
  "title": "AliceCommandsContentBundle",
  "type": "object",
  "required": [
    "schema_version",
    "content_version",
    "published_at",
    "min_app_version",
    "categories",
    "commands",
    "scenario_templates",
    "checklist_items"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "content_version": { "type": "integer", "minimum": 0 },
    "published_at": { "type": "string", "format": "date-time" },
    "min_app_version": { "type": "string", "pattern": "^\\d+\\.\\d+" },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "command_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/commandGroup" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "scenario_templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenarioTemplate" }
    },
    "checklist_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/checklistItem" }
    },
    "command_of_day": { "$ref": "#/$defs/commandOfDay" }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "title_ru", "sort_order", "source_url"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title_ru": { "type": "string", "minLength": 1 },
        "title_kk": { "type": "string" },
        "sort_order": { "type": "integer" },
        "featured": { "type": "boolean" },
        "icon_key": { "type": "string" },
        "icon_url": { "type": "string", "format": "uri" },
        "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent_color_dark": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "description_ru": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "device_types": {
          "type": "array",
          "items": { "enum": ["station", "tv", "phone"] }
        }
      }
    },
    "commandGroup": {
      "type": "object",
      "required": ["id", "category_id", "title_ru", "sort_order"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "category_id": { "type": "string" },
        "title_ru": { "type": "string", "minLength": 1 },
        "description_ru": { "type": "string" },
        "sort_order": { "type": "integer" },
        "icon_key": { "type": "string" },
        "icon_url": { "type": "string", "format": "uri" },
        "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent_color_dark": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "featured": { "type": "boolean" },
        "preview_command_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "id",
        "category_id",
        "title_ru",
        "phrases",
        "effect_description_ru",
        "requires_alice_word",
        "source_url",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category_id": { "type": "string" },
        "group_id": { "type": "string" },
        "sort_order": { "type": "integer" },
        "variant_label_ru": { "type": "string" },
        "is_primary_in_group": { "type": "boolean" },
        "title_ru": { "type": "string", "minLength": 1 },
        "phrases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "effect_description_ru": { "type": "string", "minLength": 1 },
        "requires_alice_word": { "type": "boolean" },
        "requires_plus": { "type": "boolean" },
        "device_types": {
          "type": "array",
          "items": { "enum": ["station", "tv", "phone"] }
        },
        "related_command_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "search_aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_url": { "type": "string", "format": "uri" },
        "published_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "scenarioTemplate": {
      "type": "object",
      "required": ["id", "title_ru", "source_url"],
      "properties": {
        "id": { "type": "string" },
        "title_ru": { "type": "string" },
        "trigger_ru": { "type": "string" },
        "actions_ru": { "type": "array", "items": { "type": "string" } },
        "example_phrases": { "type": "array", "items": { "type": "string" } },
        "audience": { "type": "string" },
        "deep_link_hint": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" }
      }
    },
    "checklistItem": {
      "type": "object",
      "required": ["id", "order", "command_id"],
      "properties": {
        "id": { "type": "string" },
        "order": { "type": "integer", "minimum": 1, "maximum": 10 },
        "command_id": { "type": "string" },
        "hint_ru": { "type": "string" }
      }
    },
    "commandOfDay": {
      "type": "object",
      "required": ["mode", "command_id", "resolved_date", "updated_at"],
      "properties": {
        "mode": { "enum": ["manual", "auto"] },
        "command_id": { "type": "string", "minLength": 1 },
        "auto_category_id": { "type": ["string", "null"] },
        "auto_seed": { "type": "integer", "minimum": 1, "default": 31 },
        "resolved_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "if": { "properties": { "mode": { "const": "auto" } } },
      "then": { "required": ["auto_category_id"] }
    }
  }
}
