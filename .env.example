# Application
APP_ENV=local
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Admin (single user)
# ADMIN_PASSWORD: plain text for local dev, or bcrypt hash ($2a$...) for staging/prod
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/alice_commands
DATABASE_USER=alice
DATABASE_PASSWORD=alice_dev

# Bundle storage (local path or s3:// later)
BUNDLE_STORAGE_PATH=./storage/bundles
MANIFEST_STORAGE_PATH=./storage/manifest
BUNDLE_RETENTION_COUNT=5

# Security — required; used to sign admin session cookies (HMAC-SHA256)
SESSION_SECRET=generate-random-32-chars-minimum
ADMIN_LOGIN_RATE_LIMIT=5

# Optional: path to seed catalog on server (for admin «Import seed» button)
# CONTENT_SEED_PATH=./seed/full-catalog.json

# Optional local override: create gradle-local.properties (gitignored) with:
# org.gradle.java.home=C:/path/to/jdk
